{
  "name": "Tellbird word lists",
  "description": "Chat commands for mods to edit Tellbird's word lists: !acronym (read letter by letter), !abbreviation (slang to expand) and !ttsemote (emotes to leave out). Each takes add or remove.",
  "author": "Tellbird",
  "version": 1,
  "requireCurrency": false,
  "importQuestions": [
    {
      "id": "fafd42ee-5020-43f9-9f0f-1bdbdcec8c00",
      "replaceToken": "%TellbirdAddress%",
      "answerType": "text",
      "question": "Tellbird's address",
      "helpText": "Where Tellbird's panel opens, without a trailing slash. Only change it if you changed Tellbird's HTTP host or port.",
      "defaultAnswer": "http://127.0.0.1:5050"
    }
  ],
  "components": {
    "commands": [
      {
        "id": "409b2a9e-96ba-41fa-9e19-748669b2a0d1",
        "type": "custom",
        "active": true,
        "simple": false,
        "trigger": "!acronym",
        "aliases": [],
        "createdBy": "Tellbird",
        "description": "Tellbird: add or remove acronyms read letter by letter.",
        "usage": "!acronym add GPU | !acronym remove GPU",
        "cooldown": {
          "global": 0,
          "user": 0
        },
        "ignoreBot": true,
        "restrictionData": {
          "mode": "all",
          "sendFailMessage": true,
          "restrictions": [
            {
              "id": "0b79eff0-434b-41a8-a816-ef4e93721f92",
              "type": "firebot:permissions",
              "mode": "roles",
              "roleIds": [
                "broadcaster",
                "mod"
              ],
              "username": "",
              "ranks": []
            }
          ]
        },
        "effects": {
          "id": "bdfd71f5-c9f8-4f95-96f7-75dee7968658",
          "list": [
            {
              "id": "4589f18c-7bc2-4283-b34f-f38b51e44fc4",
              "active": true,
              "type": "firebot:chat",
              "chatter": "Bot",
              "message": "Use: !acronym add GPU | !acronym remove GPU",
              "sendAsReply": true
            }
          ]
        },
        "subCommands": [
          {
            "id": "d82d9b3c-f32d-4790-93df-9c8c123d1856",
            "arg": "add",
            "usage": "add GPU",
            "active": true,
            "regex": false,
            "minArgs": 2,
            "description": "Add acronyms read letter by letter",
            "effects": {
              "id": "5e696b2e-d5f8-423e-821e-c598fb13d57c",
              "list": [
                {
                  "id": "b4a23630-5bfb-445e-b44c-2897f700d686",
                  "active": true,
                  "type": "firebot:http-request",
                  "url": "%TellbirdAddress%/api/lists/acronyms/add",
                  "method": "POST",
                  "body": "$arg[2,last]",
                  "headers": [
                    {
                      "key": "Content-Type",
                      "value": "text/plain"
                    }
                  ],
                  "options": {
                    "timeout": 5000,
                    "runEffectsOnError": false
                  },
                  "errorEffects": {
                    "id": "ba69a653-a0e2-4674-bdf1-76c48fc075b3",
                    "list": []
                  }
                },
                {
                  "id": "1e324c1a-d2c8-428c-bc23-c50fd6b909af",
                  "active": true,
                  "type": "firebot:chat",
                  "chatter": "Bot",
                  "message": "$effectOutput[httpResponse, null, Tellbird did not answer. Is it running?]",
                  "sendAsReply": true
                }
              ]
            }
          },
          {
