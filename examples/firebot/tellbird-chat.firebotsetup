{
  "name": "Tellbird chat with TTS names",
  "description": "Reads Twitch chat through Tellbird (Mode: http) as \"name says: message\". Subs, VIPs and mods can pick the name Tellbird uses for them with !ttsname. Mods: !changename @user name, !removename @user, !revokename @user. Streamer: !clearnames. Plus Skip TTS / Clear TTS queue quick actions.",
  "version": 1,
  "author": "DesignedByJoe, adapted for Tellbird",
  "components": {
    "commands": [
      {
        "active": true,
        "simple": false,
        "sendCooldownMessage": true,
